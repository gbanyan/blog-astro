---
import RightSidebarContent from './right-sidebar-content.astro';
import { SidebarDrawer } from './sidebar-drawer';

interface Props {
  locale: string;
  tags: { tag: string; slug: string; count: number }[];
  aboutUrl: string;
  avatarSrc: string;
  variant?: 'default' | 'reading';
}

const { locale, tags, aboutUrl, avatarSrc, variant = 'default' } = Astro.props;
const readingLayout = variant === 'reading';
const sidebarLocale = locale === 'en' ? 'en' : 'zh-TW';

/**
 * Static host for the source's `SidebarLayout`. The desktop sidebar is plain
 * server-rendered markup (only the Mastodon feed inside it is an island, so
 * React is not needed on mobile where the sidebar is hidden). The mobile
 * drawer is a React island that receives the same server-rendered sidebar
 * content as its slot (rendered into the drawer only while it is open).
 */
---
<div
  class:list={[
    'grid items-start gap-8',
    readingLayout
      ? 'lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-10 xl:grid-cols-[minmax(0,1fr)_20rem] xl:gap-14'
      : 'lg:grid-cols-[minmax(0,3fr)_minmax(0,1.4fr)] lg:gap-12'
  ]}
>
  <div class="min-w-0">
    <slot />
  </div>
  <div class="hidden lg:block">
    <aside class="hidden lg:block">
      <div class={readingLayout ? 'sticky top-24' : 'sticky top-20'}>
        <RightSidebarContent
          tags={tags}
          aboutUrl={aboutUrl}
          avatarSrc={avatarSrc}
          locale={sidebarLocale}
          variant={variant}
        />
      </div>
    </aside>
  </div>
</div>
<SidebarDrawer client:idle locale={sidebarLocale}>
  <RightSidebarContent
    tags={tags}
    aboutUrl={aboutUrl}
    avatarSrc={avatarSrc}
    locale={sidebarLocale}
    variant={variant}
  />
</SidebarDrawer>
