---
import RightSidebarContent from './right-sidebar-content.astro';
import { SidebarDrawer } from './sidebar-drawer';

interface Props {
  locale: string;
  tags: { tag: string; slug: string; count: number }[];
  aboutUrl: string;
  avatarSrc: string;
  variant?: 'default' | 'reading';
}

const { locale, tags, aboutUrl, avatarSrc, variant = 'default' } = Astro.props;
const readingLayout = variant === 'reading';
const sidebarLocale = locale === 'en' ? 'en' : 'zh-TW';

/**
 * Static host for the source's `SidebarLayout`. The sidebar is rendered once,
 * as plain server markup in the desktop aside (only the Mastodon feed inside
 * it is an island). Below `lg` that aside is hidden; the mobile drawer island
 * borrows the same `[data-sidebar-content]` node while it is open instead of
 * shipping a second copy of the markup.
 */
---
<div
  class:list={[
    'grid items-start gap-8',
    readingLayout
      ? 'lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-10 xl:grid-cols-[minmax(0,1fr)_20rem] xl:gap-14'
      : 'lg:grid-cols-[minmax(0,3fr)_minmax(0,1.4fr)] lg:gap-12'
  ]}
>
  <div class="min-w-0">
    <slot />
  </div>
  <div class="hidden lg:block">
    <aside class="hidden lg:block">
      <div class={readingLayout ? 'sticky top-24' : 'sticky top-20'}>
        <div data-sidebar-content>
          <RightSidebarContent
            tags={tags}
            aboutUrl={aboutUrl}
            avatarSrc={avatarSrc}
            locale={sidebarLocale}
            variant={variant}
          />
        </div>
      </div>
    </aside>
  </div>
</div>
<SidebarDrawer client:idle locale={sidebarLocale} />
