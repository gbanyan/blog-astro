---
/**
 * Port of components/site-header.tsx — a static `.astro` host that computes
 * the navigation model from content + dictionaries and composes the client
 * islands (NavMenu, SiteHeaderSearch) with the static LanguageSwitcher and
 * ThemeToggle (no React needed for either).
 *
 * `LocalizedLink` links are pre-localized here with `localizedPath` before
 * being handed to islands.
 */
import { loadContent, allPagesByLocale, allPostsByLocale, getPagesByLocale } from '@/lib/content';
import { getDictionary } from '@/lib/i18n/dictionaries';
import { LOCALE_ROUTE_MANIFEST, type LocaleRouteManifest } from '@/lib/locale-switcher';
import { documentPath, localizedPath, type Locale } from '@/lib/locales';
import ThemeToggle from './theme-toggle.astro';
import { NavMenu, type IconKey, type NavLinkItem } from './nav-menu';
import { SiteHeaderSearch } from './site-header-search';
import LanguageSwitcher from './language-switcher.astro';

interface Props {
  locale: Locale;
  currentPath: string;
  recentPosts?: { title: string; url: string }[];
}

const { locale, currentPath, recentPosts = [] } = Astro.props;
await loadContent();

const dictionary = getDictionary(locale);
const pages = getPagesByLocale(locale)
  .slice()
  .sort((a, b) => (a.title || '').localeCompare(b.title || ''));

const localeManifest: LocaleRouteManifest = { ...LOCALE_ROUTE_MANIFEST };
const allDocuments = [...allPagesByLocale, ...allPostsByLocale];
// First English match wins (same as the former linear `find`).
const englishByTranslationId = new Map<string, (typeof allDocuments)[number]>();
for (const candidate of allDocuments) {
  if (candidate.locale === 'en' && !englishByTranslationId.has(candidate.translationId)) {
    englishByTranslationId.set(candidate.translationId, candidate);
  }
}
for (const document of allDocuments) {
  if (document.locale !== 'zh-TW') continue;
  const translation = englishByTranslationId.get(document.translationId);
  if (translation) {
    const defaultPath = documentPath(document, 'zh-TW');
    localeManifest[defaultPath] = {
      defaultPath,
      en: documentPath(translation, 'en'),
    };
  }
}

// Nav groups are driven by declarative frontmatter: pages declare
// `nav_category`, `nav_label` and `icon` instead of string-matching
// titles/slugs at runtime.
const aboutChildren: NavLinkItem[] = [
  ...pages
    .filter((page) => page.nav_category === 'about')
    .map((page) => ({
      key: page._id,
      href: localizedPath(page.url, locale),
      label: page.nav_label || page.title,
      iconKey: (page.icon as IconKey) ?? 'user',
    })),
  { key: 'projects', href: localizedPath('/projects', locale), label: dictionary.navigation.projects, iconKey: 'pen' },
];

const deviceChildren: NavLinkItem[] = pages
  .filter((page) => page.nav_category === 'device')
  .map((page) => ({
    key: page._id,
    href: localizedPath(page.url, locale),
    label: page.nav_label || page.title,
    iconKey: (page.icon as IconKey) ?? 'device',
  }));

const navItems: NavLinkItem[] = [
  { key: 'home', href: localizedPath('/', locale), label: dictionary.navigation.home, iconKey: 'home' },
  { key: 'blog', href: localizedPath('/blog', locale), label: dictionary.search.blog, iconKey: 'blog' },
  { key: 'tags', href: localizedPath('/tags', locale), label: dictionary.search.tags, iconKey: 'tags' },
  {
    key: 'about',
    href: aboutChildren[0]?.href,
    label: dictionary.navigation.about,
    iconKey: 'user',
    children: aboutChildren,
  },
  {
    key: 'devices',
    href: deviceChildren[0]?.href,
    label: dictionary.navigation.devices,
    iconKey: 'device',
    children: deviceChildren,
  },
];
---

<header class="relative z-40 bg-white/80 backdrop-blur transition-colors duration-200 ease-snappy dark:bg-gray-950/80">
  <div class="container mx-auto flex items-center justify-between px-4 py-3 text-slate-900 dark:text-slate-100">
    <a
      href={localizedPath('/', locale)}
      class="motion-link group relative type-title whitespace-nowrap text-slate-900 hover:text-accent focus-visible:outline-none focus-visible:text-accent dark:text-slate-100 dark:hover:text-accent-textDark"
    >
      <span class="absolute -bottom-0.5 left-0 h-[2px] w-0 bg-accent transition-all duration-180 ease-snappy group-hover:w-full" aria-hidden="true" />
      {dictionary.brand.title}
    </a>
    <div class="flex items-center gap-3">
      <NavMenu
        client:idle
        items={navItems}
        currentPath={currentPath}
        labels={{
          openMenu: dictionary.common.openMenu,
          closeMenu: dictionary.common.closeMenu,
          navigationMenu: dictionary.common.navigationMenu,
          mainNavigation: dictionary.common.mainNavigation,
          copyright: dictionary.common.copyright,
        }}
      />
      <SiteHeaderSearch
        client:idle
        recentPosts={recentPosts}
        locale={locale}
        searchLabels={dictionary.search}
        errorLabel={dictionary.errors.errorTitle}
        currentPath={currentPath}
      />
      <LanguageSwitcher
        manifest={localeManifest}
        currentPath={currentPath}
        labels={dictionary.language}
      />
      <ThemeToggle
        labels={{
          switchToLight: dictionary.common.switchToLight,
          switchToDark: dictionary.common.switchToDark,
        }}
      />
    </div>
  </div>
</header>
