---
/**
 * Static port of the former `RightSidebarContent` React component. Only the
 * Mastodon feed is interactive, so it is the sole island here (client:visible:
 * it never hydrates while the desktop sidebar is `display:none` on mobile, and
 * inside the mobile drawer it hydrates once the drawer opens).
 *
 * Markup and classes mirror the React version 1:1. The Mastodon island renders
 * inside an `<astro-island>` (display: contents), so the reading-variant
 * overrides target the feed `section` as a descendant instead of a child.
 */
import { FaGithub, FaMastodon, FaLinkedin } from 'react-icons/fa';
import { FiTrendingUp, FiArrowRight } from 'react-icons/fi';
import type { IconType } from 'react-icons';
import { siteConfig } from '@/lib/config';
import { localizedPath, type Locale } from '@/lib/locales';
import { getDictionary } from '@/lib/i18n/dictionaries';
import { getBuildTimeMastodonAccountId } from '@/lib/mastodon';
import { MastodonFeed } from './mastodon-feed';

interface Props {
  tags: { tag: string; slug: string; count: number }[];
  aboutUrl: string;
  avatarSrc: string;
  locale: Locale;
  variant?: 'default' | 'reading';
}

const { tags, aboutUrl, avatarSrc, locale, variant = 'default' } = Astro.props;
const dictionary = getDictionary(locale);
const readingVariant = variant === 'reading';
const mastodonAccountId = await getBuildTimeMastodonAccountId(siteConfig.social.mastodon);

const socialItems = [
  siteConfig.social.github && { key: 'github', href: siteConfig.social.github, icon: FaGithub, label: 'GitHub' },
  siteConfig.social.mastodon && { key: 'mastodon', href: siteConfig.social.mastodon, icon: FaMastodon, label: 'Mastodon' },
  siteConfig.social.linkedin && { key: 'linkedin', href: siteConfig.social.linkedin, icon: FaLinkedin, label: 'LinkedIn' },
].filter(
  // `'' && {…}` yields '' (falsy string): only fully-configured services render.
  (item): item is { key: string; href: string; icon: IconType; label: string } =>
    typeof item === 'object' && item !== null && item.href !== ''
);

const aboutLines = dictionary.brand.aboutShort ? dictionary.brand.aboutShort.split(/\n+/) : [];
---

<div class={readingVariant ? 'flex flex-col gap-6' : 'flex flex-col gap-4'}>
  <section
    class={readingVariant
      ? 'relative overflow-hidden rounded-xl border border-slate-200/70 bg-slate-50/60 px-4 py-5 dark:border-slate-800/80 dark:bg-slate-900/40 dark:text-slate-100'
      : 'motion-card group relative overflow-hidden rounded-xl border bg-white px-4 py-4 shadow-sm hover:bg-slate-50 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100 dark:hover:bg-slate-800/80'}
  >
    {!readingVariant && (
      <>
        <div class="pointer-events-none absolute -left-10 -top-10 h-24 w-24 rounded-full bg-sky-300/35 blur-3xl mix-blend-soft-light dark:bg-sky-500/25" />
        <div class="pointer-events-none absolute -bottom-12 right-[-2.5rem] h-28 w-28 rounded-full bg-indigo-300/30 blur-3xl mix-blend-soft-light dark:bg-indigo-500/20" />
      </>
    )}

    <div class="relative flex flex-col items-center">
      <a
        href={aboutUrl}
        aria-label={dictionary.sidebar.aboutAuthor}
        class="mb-2 inline-block transition-transform duration-300 ease-out group-hover:-translate-y-0.5"
      >
        {avatarSrc ? (
          <img
            src={avatarSrc}
            alt={siteConfig.name}
            width={96}
            height={96}
            class={readingVariant
              ? 'h-20 w-20 rounded-full border border-slate-200 object-cover dark:border-slate-700'
              : 'h-24 w-24 rounded-full border border-slate-200 object-cover shadow-sm transition-transform duration-300 ease-out group-hover:scale-105 dark:border-slate-700'}
          />
        ) : (
          <div
            class={readingVariant
              ? 'flex h-20 w-20 items-center justify-center rounded-full bg-slate-900 text-lg font-semibold text-slate-50 dark:bg-slate-100 dark:text-slate-900'
              : 'flex h-24 w-24 items-center justify-center rounded-full bg-slate-900 text-lg font-semibold text-slate-50 shadow-sm transition-transform duration-300 ease-out group-hover:scale-105 dark:bg-slate-100 dark:text-slate-900'}
          >
            {siteConfig.name.charAt(0).toUpperCase()}
          </div>
        )}
      </a>
      {socialItems.length > 0 && (
        <div class="mt-2 flex items-center gap-3 text-lg text-accent-textLight dark:text-accent-textDark">
          {socialItems.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel={item.key === 'mastodon' ? 'me noopener noreferrer' : 'noopener noreferrer'}
              aria-label={item.label}
              class="motion-link inline-flex h-8 w-8 items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:-translate-y-0.5 hover:bg-accent-soft hover:text-accent dark:bg-slate-800 dark:text-slate-200 dark:hover:text-accent-textDark"
            >
              <item.icon className="h-4 w-4" />
            </a>
          ))}
        </div>
      )}
      {aboutLines.length > 0 && (
        <div class="type-body mt-3 space-y-1 text-center text-slate-600 dark:text-slate-200">
          {aboutLines.map((line) => <p>{line}</p>)}
        </div>
      )}
    </div>
  </section>

  <div
    class={readingVariant
      ? '[&_section]:!border-slate-200/70 [&_section]:!bg-slate-50/60 [&_section]:!shadow-none [&_section]:hover:!translate-y-0 dark:[&_section]:!border-slate-800/80 dark:[&_section]:!bg-slate-900/40'
      : undefined}
  >
    <MastodonFeed client:visible={{ rootMargin: '100px' }} locale={locale} labels={dictionary.mastodon} accountId={mastodonAccountId} />
  </div>

  {tags.length > 0 && (
    <section
      class={readingVariant
        ? 'rounded-xl border border-slate-200/70 bg-slate-50/60 px-4 py-4 dark:border-slate-800/80 dark:bg-slate-900/40 dark:text-slate-100'
        : 'motion-card rounded-xl border bg-white px-4 py-3 shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:text-slate-100'}
    >
      <h2 class="type-small flex items-center gap-2 font-semibold uppercase tracking-[0.35em] text-slate-500 dark:text-slate-400">
        <FiTrendingUp className="h-3 w-3 text-orange-400" />
        {dictionary.sidebar.popularTags}
      </h2>
      <div class="mt-2 flex flex-wrap gap-2 text-base">
        {tags.map(({ tag, slug, count }) => {
          const sizeClass = count >= 5 ? 'font-semibold' : count >= 3 ? 'font-medium' : '';
          return (
            <a
              href={localizedPath(`/tags/${slug}`, locale)}
              class={`${sizeClass} tag-chip rounded-full px-2 py-0.5 transition ${
                readingVariant
                  ? 'bg-white text-slate-600 ring-1 ring-inset ring-slate-200 hover:bg-slate-100 hover:text-accent-textLight dark:bg-slate-900/70 dark:text-slate-300 dark:ring-slate-700 dark:hover:bg-slate-800 dark:hover:text-accent-textDark'
                  : 'bg-accent-soft text-accent-textLight hover:bg-accent hover:text-white dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700 dark:hover:text-white'
              }`}
            >
              {tag}
            </a>
          );
        })}
      </div>
      <div class="mt-3 type-small text-slate-500 dark:text-slate-400">
        <a
          href={localizedPath('/tags', locale)}
          class="motion-link inline-flex items-center gap-1 text-accent-textLight hover:text-accent dark:text-accent-textDark dark:hover:text-accent-textDark"
        >
          {dictionary.common.allTags}
          <FiArrowRight className="h-3 w-3" />
        </a>
      </div>
    </section>
  )}
</div>
