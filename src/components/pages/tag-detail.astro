---
/**
 * Tag archive (`/tags/[tag]`, `/en/tags/[tag]`): the posts of one tag, titled
 * with the tag's original label. Route files only bind the locale.
 */
import { getPosts } from '@/lib/content';
import { getDictionary } from '@/lib/i18n/dictionaries';
import type { Locale } from '@/lib/locales';
import { getPostListEntries } from '@/lib/content-images';
import { metadataForTag } from '@/lib/seo';
import { getSidebarData } from '@/lib/sidebar-data';
import { tagSchema } from '@/lib/structured-data';
import { postsWithTag, tagLabelForSlug } from '@/lib/tags';
import Layout from '@/layouts/layout.astro';
import LayoutShell from '@/layouts/layout-shell.astro';
import JsonLd from '@/components/json-ld.astro';
import SidebarLayout from '@/components/sidebar-layout.astro';
import SectionDividerStatic from '@/components/section-divider-static.astro';
import { PostListWithControls } from '@/components/post-list-with-controls';
import ScrollReveal from '@/components/scroll-reveal.astro';

interface Props {
  locale: Locale;
  /** URL tag slug (`getTagSlug`-normalized). */
  tagSlug: string;
}

const { locale, tagSlug } = Astro.props;
const dictionary = getDictionary(locale);
const { tags: sidebarTags, aboutUrl, avatarSrc } = await getSidebarData(locale);
const posts = postsWithTag(tagSlug, await getPosts(locale));
const tagLabel = tagLabelForSlug(tagSlug, posts);
// Slim, build-time-computed entries keep the island props small.
const listEntries = await getPostListEntries(posts);
---
<Layout head={metadataForTag(tagLabel, locale)} locale={locale}>
  <LayoutShell locale={locale} currentPath={Astro.url.pathname}>
    <JsonLd schema={tagSchema(locale, tagLabel, posts)} />
    <SidebarLayout locale={locale} tags={sidebarTags} aboutUrl={aboutUrl} avatarSrc={avatarSrc}>
      <SectionDividerStatic>
        <div class="motion-card mb-8 rounded-2xl border border-white/40 bg-white/60 p-8 text-center shadow-lg backdrop-blur-md dark:border-white/10 dark:bg-slate-900/60">
          <div class="inline-flex items-center gap-2 text-accent">
            <!-- FiTag (inlined from react-icons for static markup) -->
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z" />
              <line x1="7" y1="7" x2="7.01" y2="7" />
            </svg>
            <span class="type-small uppercase tracking-[0.4em] text-slate-500 dark:text-slate-400">
              TAG ARCHIVE
            </span>
          </div>
          <h1 class="type-title mt-2 font-semibold text-slate-900 dark:text-slate-50">
            {tagLabel}
          </h1>
          <p class="type-small mt-2 text-slate-600 dark:text-slate-300">
            {dictionary.tags.count(posts.length)}
          </p>
        </div>
      </SectionDividerStatic>
      <PostListWithControls client:load posts={listEntries} locale={locale} />
    </SidebarLayout>
    <ScrollReveal />
  </LayoutShell>
</Layout>
