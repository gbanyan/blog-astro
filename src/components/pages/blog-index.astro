---
/** Blog index (`/blog`, `/en/blog`). Route files only bind the locale. */
import { getAllPostsSorted } from '@/lib/posts';
import { getSidebarData } from '@/lib/sidebar-data';
import type { Locale } from '@/lib/locales';
import { blogIndexSchema } from '@/lib/structured-data';
import Layout from '@/layouts/layout.astro';
import LayoutShell from '@/layouts/layout-shell.astro';
import JsonLd from '@/components/json-ld.astro';
import { metadataForSection } from '@/lib/seo';
import { getDictionary } from '@/lib/i18n/dictionaries';
import SidebarLayout from '@/components/sidebar-layout.astro';
import SectionDividerStatic from '@/components/section-divider-static.astro';
import { PostListWithControls } from '@/components/post-list-with-controls';
import ScrollReveal from '@/components/scroll-reveal.astro';
import { getPostListEntries } from '@/lib/content-images';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const posts = await getAllPostsSorted(locale);
const { tags, aboutUrl, avatarSrc } = await getSidebarData(locale);
// Slim, build-time-computed entries keep the island props small.
const listEntries = await getPostListEntries(posts);
---
<Layout head={metadataForSection('blog', locale)} locale={locale}>
  <LayoutShell locale={locale} currentPath={Astro.url.pathname}>
    <section class="space-y-4">
      <JsonLd schema={blogIndexSchema(locale, posts)} />
      <SidebarLayout locale={locale} tags={tags} aboutUrl={aboutUrl} avatarSrc={avatarSrc}>
        <SectionDividerStatic>
          <header class="space-y-1">
            <h1 class="type-title font-semibold text-slate-900 dark:text-slate-50">
              {dictionary.common.allPosts}
            </h1>
            <p class="type-small text-slate-500 dark:text-slate-400">
              {dictionary.common.allPostsDescription}
            </p>
          </header>
        </SectionDividerStatic>
        <ScrollReveal />
        <PostListWithControls
          client:load
          posts={listEntries}
          locale={locale}
          initialSearch=""
        />
      </SidebarLayout>
    </section>
  </LayoutShell>
</Layout>
