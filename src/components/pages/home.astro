---
/** Home page (`/`, `/en`). Route files only bind the locale. */
import { siteConfig } from '@/lib/config';
import { getAllPostsSorted } from '@/lib/posts';
import { getSidebarData } from '@/lib/sidebar-data';
import { localizedPath, type Locale } from '@/lib/locales';
import { homeSchema } from '@/lib/structured-data';
import Layout from '@/layouts/layout.astro';
import LayoutShell from '@/layouts/layout-shell.astro';
import JsonLd from '@/components/json-ld.astro';
import { metadataForSection } from '@/lib/seo';
import { getDictionary } from '@/lib/i18n/dictionaries';
import SidebarLayout from '@/components/sidebar-layout.astro';
import { HeroSection, INTRO_PLAYED_KEY } from '@/components/hero-section';
import { getPostListEntries } from '@/lib/content-images';
// Server-rendered only (no client directive): the same item the /blog island uses, zero JS here.
import { PostListItem } from '../post-list-item';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const { tags, aboutUrl, avatarSrc } = await getSidebarData(locale);
const posts = await getPostListEntries(
  (await getAllPostsSorted(locale)).slice(0, siteConfig.postsPerPage)
);
---
<Layout head={metadataForSection('home', locale)} locale={locale}>
  <LayoutShell locale={locale} currentPath={Astro.url.pathname}>
    <JsonLd schema={homeSchema(locale)} />
    <section class="pb-4 sm:pb-8">
      <SidebarLayout locale={locale} tags={tags} aboutUrl={aboutUrl} avatarSrc={avatarSrc} variant="reading">
        <div class="space-y-10 sm:space-y-12 lg:space-y-14">
          <h1 class="sr-only">
            {siteConfig.name} — {dictionary.common.latestPosts} — {dictionary.brand.tagline}
          </h1>
          <!-- `contents` keeps the hero's layout identical to the bare island. -->
          <div data-home-hero class="contents">
            <HeroSection
              client:idle
              title={`${siteConfig.name} — ${dictionary.common.latestPosts}`}
              tagline={dictionary.brand.tagline}
              ariaLabel={dictionary.terminal.ariaLabel(
                `${siteConfig.name} — ${dictionary.common.latestPosts}`,
                dictionary.brand.tagline
              )}
            />
          </div>
          <!-- Before paint: on a return visit this session (or under reduced
               motion) show the server-rendered finished terminal at once. -->
          <script is:inline data-astro-rerun define:vars={{ introKey: INTRO_PLAYED_KEY }}>
            let played = matchMedia('(prefers-reduced-motion: reduce)').matches;
            try {
              played ||= sessionStorage.getItem(introKey) === '1';
            } catch {
              // Storage blocked: treat as a first visit.
            }
            if (played) {
              document.querySelector('[data-home-hero]')?.setAttribute('data-intro-played', '');
            }
          </script>
          <noscript><style>[data-home-hero] [data-terminal-content] { visibility: visible !important; }</style></noscript>

          <section aria-labelledby="latest-posts-heading">
            <header class="mb-6 flex items-end justify-between gap-4 border-b border-slate-200/80 pb-3 dark:border-slate-800">
              <h2
                id="latest-posts-heading"
                class="text-xl font-semibold tracking-tight text-slate-900 dark:text-slate-100 sm:text-2xl"
              >
                {dictionary.common.latestPosts}
              </h2>
              <a
                href={localizedPath('/blog', locale)}
                class="shrink-0 text-sm font-medium text-accent-textLight transition-colors hover:text-accent dark:text-accent-textDark dark:hover:text-accent-textDark"
              >
                {dictionary.common.allPosts} →
              </a>
            </header>
            <!-- Static timeline: ports TimelineWrapper's mounted-state markup
                 (spine + per-item connector ticks) without a client island. -->
            <div class="relative pl-6 md:pl-8">
              <span class="pointer-events-none absolute left-2 top-0 h-full w-[2px] rounded-full bg-accent/40 md:left-3" aria-hidden="true"></span>
              <div class="space-y-4">
                {posts.map((post, index) => (
                  <div class="relative pl-5 sm:pl-8">
                    <span class="pointer-events-none absolute left-0 top-1/2 h-px w-5 -translate-x-full -translate-y-1/2 bg-gradient-to-r from-transparent via-accent/30 to-transparent sm:w-8" aria-hidden="true"></span>
                    <PostListItem post={post} priority={index === 0} variant="reading" />
                  </div>
                ))}
              </div>
            </div>
          </section>
        </div>
      </SidebarLayout>
    </section>
  </LayoutShell>
</Layout>
