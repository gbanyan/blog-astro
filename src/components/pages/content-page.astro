---
import type { Component } from 'astro';
import type { Page } from '@/lib/content';
import type { Dictionary } from '@/lib/i18n/dictionaries';
import type { Locale } from '@/lib/locales';
import { getDocumentLocale, absoluteUrl, documentPath, localizedPath } from '@/lib/locales';
import { siteConfig } from '@/lib/config';
import { getTagSlug } from '@/lib/tags';
import { socialImageUrl } from '@/lib/og';
import { MermaidRenderer } from '../mermaid-renderer';
import { ReadingProgress } from '../reading-progress';
import { ScrollReveal } from '../scroll-reveal';
import { DevEnvDeviceHero } from '../dev-env-device-hero';
import { HomeLabDeviceHero } from '../homelab-device-hero';
import SectionDividerStatic from '../section-divider-static.astro';
import PostLayout from '../post-layout.astro';

interface Props {
  page: Page;
  locale: Locale;
  dictionary: Dictionary;
  hasToc: boolean;
  Content: Component;
}

const { page, locale, dictionary, hasToc, Content } = Astro.props;

// Declarative layout/hero metadata — no slug string-matching.
const isDevice = page.layout === 'device';
const pageUrl = absoluteUrl(documentPath(page, locale));
const imageUrl = socialImageUrl(page.feature_image) ?? `${siteConfig.url}${siteConfig.ogImage}`;

// WebPage Schema
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.title,
  description: page.description || page.title,
  url: pageUrl,
  image: imageUrl,
  inLanguage: getDocumentLocale(page),
  isPartOf: {
    '@type': 'WebSite',
    name: dictionary.brand.title,
    url: siteConfig.url
  },
  ...(page.published_at ? { datePublished: page.published_at } : {}),
  ...(page.updated_at ? { dateModified: page.updated_at } : {})
};

const slug = page.slug || page.flattenedPath;
---
<script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
<ReadingProgress client:idle />
<ScrollReveal client:load />
<PostLayout hasToc={hasToc} contentKey={slug} wide={isDevice} locale={locale}>
  <div class={isDevice ? 'space-y-4' : 'space-y-8'}>
    <!-- Main content area for Pagefind indexing -->
    <div data-pagefind-body>
      <SectionDividerStatic>
        <header class={isDevice ? 'mb-4 space-y-3 text-center' : 'mb-6 space-y-4 text-center'}>
          {page.published_at && (
            <p class="type-small text-slate-500 dark:text-slate-400">
              {new Date(page.published_at as Date | string).toLocaleDateString(
                getDocumentLocale(page)
              )}
            </p>
          )}
          <h1 class="type-display font-bold leading-tight text-slate-900 dark:text-slate-50">
            {page.title}
          </h1>
          {page.tags && (
            <div class="flex flex-wrap justify-center gap-2 pt-2" data-pagefind-meta="tags">
              {page.tags.map((t) => (
                <a
                  href={localizedPath(`/tags/${encodeURIComponent(getTagSlug(t))}`, locale)}
                  class="tag-chip rounded-full bg-accent-soft px-3 py-1 text-sm text-accent-textLight dark:bg-slate-800 dark:text-slate-100"
                >
                  #{t}
                </a>
              ))}
            </div>
          )}
        </header>
      </SectionDividerStatic>

      <SectionDividerStatic>
        <article
          data-toc-content={slug}
          class="prose prose-lg prose-slate mx-auto max-w-none dark:prose-invert"
        >
          {page.hero === 'dev-env' ? (
            <DevEnvDeviceHero client:load ariaLabel={dictionary.devices.devEnvAria} />
          ) : page.hero === 'homelab' ? (
            <HomeLabDeviceHero client:load ariaLabel={dictionary.devices.homeLabAria} />
          ) : (
            page.feature_image && (
              <div class="-mx-4 mb-8 transition-all duration-500 sm:-mx-12 lg:-mx-20 group-[.toc-open]:lg:-mx-4">
                <img
                  src={page.feature_image.replace('../assets', '/assets')}
                  alt={page.title}
                  width={1200}
                  height={600}
                  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 90vw, 1200px"
                  loading="eager"
                  fetchpriority="high"
                  class="w-full rounded-xl shadow-lg"
                />
              </div>
            )
          )}
          <div>
            <Content />
          </div>
          <MermaidRenderer client:idle labels={dictionary.mermaid} />
        </article>
      </SectionDividerStatic>
    </div>
  </div>
</PostLayout>
