---
import type { Post } from '@/lib/content';
import { siteConfig } from '@/lib/config';
import ContentImage from './content-image.astro';
import { estimateReadingMinutes, readingTimeLabel } from '@/lib/reading-time';

interface Props {
  post: Post;
  showTags?: boolean;
}

const { post, showTags = true } = Astro.props;
const readingMinutes = estimateReadingMinutes(post.body?.raw ?? '');
const cover =
  post.feature_image && post.feature_image.startsWith('../assets')
    ? post.feature_image.replace('../assets', '/assets')
    : undefined;

/** Static port of the source server component `PostCard`. */
---
<article class="motion-card group relative overflow-hidden rounded-xl border bg-white shadow-sm transition-all duration-300 ease-snappy hover:-translate-y-1 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-1 origin-left scale-x-0 bg-accent opacity-80 transition-transform duration-300 ease-out group-hover:scale-x-100"></div>
  {cover && (
    <div class="relative w-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
      <ContentImage
        src={cover}
        alt={post.title}
        width={640}
        height={360}
        widths={[320, 640, 960]}
        sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
        loading="lazy"
        class="mx-auto w-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
      />
    </div>
  )}
  <div class="space-y-3 px-4 py-4">
    <div class="flex flex-wrap items-center gap-3 text-xs">
      {post.published_at && (
        <span class="inline-flex items-center gap-1.5 text-xs transition-colors duration-180 ease-snappy text-slate-600 dark:text-slate-200">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-3.5 w-3.5 text-slate-400 dark:text-slate-500"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <span>{new Date(post.published_at as Date | string).toLocaleDateString(siteConfig.defaultLocale)}</span>
        </span>
      )}
      {readingMinutes > 1 && (
        <span class="inline-flex items-center gap-1.5 text-xs transition-colors duration-180 ease-snappy text-slate-500 dark:text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-3.5 w-3.5 text-slate-400 dark:text-slate-500"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>{readingTimeLabel(readingMinutes, post.locale)}</span>
        </span>
      )}
      {showTags && post.tags && post.tags.length > 0 && (
        <span class="inline-flex items-center gap-1.5 text-xs transition-colors duration-180 ease-snappy text-slate-500 dark:text-slate-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="h-3.5 w-3.5 text-slate-400 dark:text-slate-500"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
          <span>{post.tags.slice(0, 3).join(', ')}</span>
        </span>
      )}
    </div>
    <h2 class="font-editorial text-lg font-semibold leading-snug">
      <a href={post.url} class="hover:text-accent dark:hover:text-accent">
        {post.title}
      </a>
    </h2>
    {post.description && (
      <p class="line-clamp-3 text-sm text-slate-600 dark:text-slate-300">
        {post.description}
      </p>
    )}
  </div>
</article>
