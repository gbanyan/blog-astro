---
/**
 * Page-level scroll-reveal observer (no React island). Page markup emits
 * plain `<div class="scroll-reveal">` blocks (see section-divider-static);
 * this script observes every one of them and adds `is-visible` on first
 * intersection — same threshold, root margin, once-semantics, and 300ms
 * fallback as the former island.
 *
 * Content is never hidden by default: only blocks that start below the fold
 * when the script runs get `reveal-pending` (the hidden state, globals.css),
 * so the post header/cover paint immediately and nothing stays invisible
 * without JS. Re-runs on `astro:page-load` for ClientRouter navigations.
 */
---
<script>
  let observer: IntersectionObserver | null = null;
  let fallbackId: number | undefined;

  function teardown() {
    observer?.disconnect();
    observer = null;
    if (fallbackId) window.clearTimeout(fallbackId);
    fallbackId = undefined;
  }

  function init() {
    teardown();
    const els = Array.from(
      document.querySelectorAll<HTMLElement>('.scroll-reveal:not(.is-visible)')
    );
    if (els.length === 0) return;

    const reveal = (el: HTMLElement) => el.classList.add('is-visible');
    const revealAll = () => {
      els.forEach(reveal);
      teardown();
    };

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealAll();
      return;
    }

    // Anything already within the viewport is revealed at once (no hidden
    // frame); only blocks below the fold enter the pending/hidden state.
    const viewportHeight = window.innerHeight;
    const pending: HTMLElement[] = [];
    for (const el of els) {
      if (el.getBoundingClientRect().top < viewportHeight) {
        reveal(el);
      } else {
        el.classList.add('reveal-pending');
        pending.push(el);
      }
    }
    if (pending.length === 0) return;

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          reveal(el);
          observer?.unobserve(el);
        }
        if (pending.every((el) => el.classList.contains('is-visible'))) {
          teardown();
        }
      },
      { threshold: 0.05, rootMargin: '0px 0px -20% 0px' }
    );
    pending.forEach((el) => observer!.observe(el));
    // Safety net: reveal everything shortly after load, same as the source.
    fallbackId = window.setTimeout(revealAll, 300);
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', teardown);
</script>
