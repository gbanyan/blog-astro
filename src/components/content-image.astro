---
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';
import { contentImageSize, loadContentImage, normalizeContentAssetSrc } from '@/lib/content-images';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'alt' | 'width' | 'height'> {
  src: string;
  alt: string;
  width: number;
  height: number;
  widths?: number[];
}

// Source images stay in the content submodule; Astro generates hashed WebP
// variants during the build. The intrinsic size comes from disk, never from
// the imported metadata object — touching its properties would mark the
// original as referenced and keep it in `_astro/` (see content-images.ts).
const { src, alt, width, height, widths = [480, 800, 1200, 1600], ...attributes } = Astro.props;
const normalized = normalizeContentAssetSrc(src);
const image = await loadContentImage(normalized);
const size = image ? contentImageSize(normalized) : undefined;
const outputWidth = size ? Math.min(width, size.width) : width;
const outputWidths = size
  ? [...new Set([...widths.filter((w) => w <= size.width), outputWidth])].sort((a, b) => a - b)
  : [];
---
{image && size ? (
  <Image
    src={image}
    alt={alt}
    width={outputWidth}
    widths={outputWidths}
    format="webp"
    quality={80}
    {...attributes}
  />
) : (
  <img src={normalized} alt={alt} width={width} height={height} decoding="async" {...attributes} />
)}
