---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'alt' | 'width' | 'height'> {
  src: string;
  alt: string;
  width: number;
  height: number;
  widths?: number[];
}

// Source images stay in the content submodule; Astro generates hashed WebP
// variants during the build, with no image service or Worker execution cost.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/content/assets/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}'
);
const { src, alt, width, height, widths = [480, 800, 1200, 1600], ...attributes } = Astro.props;
const normalized = src.replace(/^\.\.\/assets\//, '/assets/');
const load = images[`/content${normalized}`];
const image = load ? (await load()).default : undefined;
const outputWidth = image ? Math.min(width, image.width) : width;
const outputWidths = image
  ? [...new Set([...widths.filter((w) => w <= image.width), outputWidth])].sort((a, b) => a - b)
  : [];
---
{image ? (
  <Image
    src={image}
    alt={alt}
    width={outputWidth}
    widths={outputWidths}
    format="webp"
    quality={80}
    {...attributes}
  />
) : (
  <img src={normalized} alt={alt} width={width} height={height} decoding="async" {...attributes} />
)}
