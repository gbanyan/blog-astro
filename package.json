{
  "name": "blog-astro",
  "version": "1.0.0",
  "description": "Personal blog built with Astro (migrated from blog-nextjs)",
  "type": "module",
  "license": "ISC",
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "scripts": {
    "predev": "npm run sync-assets",
    "dev": "astro dev",
    "build": "npm run sync-assets && npm run check-i18n-content && npm run check-assets && astro build && npx pagefind --site dist --output-path dist/_pagefind",
    "preview": "astro preview",
    "check-i18n": "node scripts/check-i18n.mjs --adapter scripts/i18n-validation-adapter.mjs",
    "check-i18n-content": "node scripts/check-i18n-content.mjs",
    "sync-assets": "node scripts/sync-assets.mjs",
    "check-assets": "node scripts/check-assets.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run build && npm run check-i18n && npm run lint && npm run test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/react": "^6.0.6",
    "@emotion/is-prop-valid": "^1.4.0",
    "@radix-ui/react-dialog": "^1.1.21",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.2",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "satori": "^0.33.4",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.134.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260917.1": true
  }
}
