# Astro fingerprints these files (JS, CSS, fonts, optimized images).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# These URLs can change content between deployments. Revalidate with ETags.
/og/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# Pagefind entry JS/JSON and WASM retain the default revalidation policy.
# Only these content-hashed search payloads can safely persist across builds.
/_pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable

/_pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
