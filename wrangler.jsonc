{
  // Static-assets-only Worker: no server code, Cloudflare serves ./dist directly.
  // Deploy: `npx wrangler deploy` (requires CLOUDFLARE_API_TOKEN or wrangler login).
  // Custom domain cutover (blog.gbanyan.net) intentionally NOT configured here —
  // add a `routes` entry only when switching off the Vercel project.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-astro",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    // Edge route: requires the existing blog.gbanyan.net DNS record to be
    // Proxied (orange cloud) in the Cloudflare dashboard. Rollback = remove
    // this route and redeploy; traffic returns to the Vercel origin instantly.
    { "pattern": "blog.gbanyan.net/*", "zone_name": "gbanyan.net" }
  ]
}
