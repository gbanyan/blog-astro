# Copy this file to `.env.local` and adjust values.
# All vars prefixed with PUBLIC_ are exposed to the browser.

# Core site info
PUBLIC_SITE_NAME="Your Name"
PUBLIC_SITE_TITLE="Your Personal Site"
PUBLIC_SITE_DESCRIPTION="Personal homepage and blog."
PUBLIC_SITE_URL="https://example.com"
PUBLIC_SITE_AUTHOR="Your Name"
PUBLIC_SITE_TAGLINE="Short tagline for your blog."
PUBLIC_POSTS_PER_PAGE="5"
PUBLIC_DEFAULT_LOCALE="zh-TW"
PUBLIC_SITE_AVATAR_URL="https://www.gravatar.com/avatar/yourhash?s=160&d=identicon"
PUBLIC_SITE_ABOUT_SHORT="A short sentence about you."

# Color scheme / accents
PUBLIC_COLOR_ACCENT="#2563eb"
PUBLIC_COLOR_ACCENT_SOFT="#dbeafe"
PUBLIC_COLOR_ACCENT_TEXT_LIGHT="#1d4ed8"
PUBLIC_COLOR_ACCENT_TEXT_DARK="#93c5fd"

# Social and profile
PUBLIC_TWITTER_HANDLE="@yourhandle"
PUBLIC_GITHUB_URL="https://github.com/yourname"
PUBLIC_LINKEDIN_URL="https://www.linkedin.com/in/yourname/"
PUBLIC_EMAIL_CONTACT="you@example.com"
PUBLIC_MASTODON_URL="https://your.instance/@yourhandle"
PUBLIC_GITEA_URL="https://gitea.example/yourname"

# SEO / Open Graph
PUBLIC_OG_DEFAULT_IMAGE="/assets/og-default.jpg"
PUBLIC_TWITTER_CARD_TYPE="summary_large_image"

# Giscus comments (optional, public values)
PUBLIC_GISCUS_REPO="owner/repo"
PUBLIC_GISCUS_REPO_ID="R_kgDOxxxxxx"
PUBLIC_GISCUS_CATEGORY="General"
PUBLIC_GISCUS_CATEGORY_ID="DIC_kwDOxxxxxx4Cxxxx"
PUBLIC_GISCUS_MAPPING="pathname"
PUBLIC_GISCUS_STRICT="0"
PUBLIC_GISCUS_REACTIONS_ENABLED="1"
PUBLIC_GISCUS_INPUT_POSITION="bottom"
PUBLIC_GISCUS_LANG="zh-TW"
PUBLIC_GISCUS_THEME_LIGHT="light"
PUBLIC_GISCUS_THEME_DARK="dark_dimmed"

# Server-side only (NOT exposed to browser)
# Used to fetch GitHub repositories for the /projects page.
# Copy these into your local `.env.local` and fill in real values.
GITHUB_USERNAME="your-github-username"
GITHUB_TOKEN="your-github-token"
